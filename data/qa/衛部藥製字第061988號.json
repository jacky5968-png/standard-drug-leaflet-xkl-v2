:[{"section_id":"s11","no":"4","title":"禁忌","quote":"對本品內含成分過敏者，請勿投與。","context":"","text_source":"VALUE","start":0,"end":16,"score":20,"dedicated":false,"order":100000}],"evidence_section_id":["s11"],"evidence_quote":["對本品內含成分過敏者，請勿投與。"],"note":"","evidence_total":1,"summary_is_excerpt":true},"common-23":{"engine_version":28,"license":"衛部藥製字第061988號","leaflet_version":"2","source_sha256":"b9a86e436995934d023f750cb3d3b50e8d59ab59e0a024b9123e5c3e021b12ca","question_id":"common-23","question":"常見副作用","answer_text":"仿單列有以下不良反應；未必代表常見：\n本品口服，偶爾發生胃腸障礙如噁心和嘔吐，極少出現如皮疹和支氣管痙攣等過敏反應。","status":"待人工審核","evidence":[{"section_id":"s29","no":"8.1","title":"臨床重要副作用/不良反應","quote":"本品口服，偶爾發生胃腸障礙如噁心和嘔吐，極少出現如皮疹和支氣管痙攣等過敏反應。","context":"副作用/不良反應","text_source":"VALUE","start":0,"end":39,"score":20,"dedicated":false,"order":280000}],"evidence_section_id":["s29"],"evidence_quote":["本品口服，偶爾發生胃腸障礙如噁心和嘔吐，極少出現如皮疹和支氣管痙攣等過敏反應。"],"note":"","evidence_total":1,"summary_is_excerpt":true},"common-24":{"engine_version":28,"license":"衛部藥製字第061988號","leaflet_version":"2","source_sha256":"b9a86e436995934d023f750cb3d3b50e8d59ab59e0a024b9123e5c3e021b12ca","question_id":"common-24","question":"嚴重警語","answer_text":"在治療時，患有支氣管哮喘的病人用藥要嚴格控制。\n出現支氣管痙攣時治療必須立刻暫停。\n藥品可能有硫臭味，此並非表示產品變質，而是此製劑中含有活性成分的一種特徵。\n（重點節錄，請配合來源章節確認完整限制。）","status":"待人工審核","evidence":[{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"在治療時，患有支氣管哮喘的病人用藥要嚴格控制。","context":"警語及注意事項","text_source":"VALUE","start":0,"end":23,"score":20,"dedicated":false,"order":120000},{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"出現支氣管痙攣時治療必須立刻暫停。","context":"警語及注意事項","text_source":"VALUE","start":23,"end":40,"score":20,"dedicated":false,"order":120001},{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"藥品可能有硫臭味，此並非表示產品變質，而是此製劑中含有活性成分的一種特徵。","context":"警語及注意事項","text_source":"VALUE","start":40,"end":77,"score":20,"dedicated":false,"order":120002},{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"最好不要將其他藥物與Acetylcysteine的溶液混在一起。","context":"警語及注意事項","text_source":"VALUE","start":77,"end":109,"score":20,"dedicated":false,"order":120003}],"evidence_section_id":["s13","s13","s13","s13"],"evidence_quote":["在治療時，患有支氣管哮喘的病人用藥要嚴格控制。","出現支氣管痙攣時治療必須立刻暫停。","藥品可能有硫臭味，此並非表示產品變質，而是此製劑中含有活性成分的一種特徵。","最好不要將其他藥物與Acetylcysteine的溶液混在一起。"],"note":"","evidence_total":4,"summary_is_excerpt":true},"common-25":{"engine_version":28,"license":"衛部藥製字第061988號","leaflet_version":"2","source_sha256":"b9a86e436995934d023f750cb3d3b50e8d59ab59e0a024b9123e5c3e021b12ca","question_id":"common-25","question":"藥物交互作用","answer_text":"仿單未明確記載。","status":"仿單未明確記載","evidence":[],"evidence_section_id":[],"evidence_quote":[],"note":"","checked_sections":["s7","s8","s9","s10","s11","s12","s13","s14","s15","s16","s17","s18","s19","s20","s21","s22","s23","s24","s25","s26","s27","s43"]},"common-26":{"engine_version":28,"license":"衛部藥製字第061988號","leaflet_version":"2","source_sha256":"b9a86e436995934d023f750cb3d3b50e8d59ab59e0a024b9123e5c3e021b12ca","question_id":"common-26","question":"作用機轉","answer_text":"乙醯半胱胺酸(Acetylcysteine, NAC)是Acetylcysteine的活性成分。\n它通過分解黏蛋白複合物、核酸，將膿性成份及其他分泌物從黏稠變為透明而發揮強烈溶黏液作用。\n此外，NAC具有直接抗氧化作用，它提供一個能與親電子的氧化基團相互發生作用的自由硫脢基(親核的-SH)。","status":"待人工審核","evidence":[{"section_id":"s34","no":"10.1","title":"作用機轉","quote":"乙醯半胱胺酸(Acetylcysteine, NAC)是Acetylcysteine的活性成分。","context":"藥理特性","text_source":"VALUE","start":0,"end":48,"score":20,"dedicated":false,"order":330000},{"section_id":"s34","no":"10.1","title":"作用機轉","quote":"它通過分解黏蛋白複合物、核酸，將膿性成份及其他分泌物從黏稠變為透明而發揮強烈溶黏液作用。","context":"藥理特性","text_source":"VALUE","start":48,"end":92,"score":20,"dedicated":false,"order":330001},{"section_id":"s34","no":"10.1","title":"作用機轉","quote":"此外，NAC具有直接抗氧化作用，它提供一個能與親電子的氧化基團相互發生作用的自由硫脢基(親核的-SH)。","context":"藥理特性","text_source":"VALUE","start":93,"end":145,"score":20,"dedicated":false,"order":330002}],"evidence_section_id":["s34","s34","s34"],"evidence_quote":["乙醯半胱胺酸(Acetylcysteine, NAC)是Acetylcysteine的活性成分。","它通過分解黏蛋白複合物、核酸，將膿性成份及其他分泌物從黏稠變為透明而發揮強烈溶黏液作用。","此外，NAC具有直接抗氧化作用，它提供一個能與親電子的氧化基團相互發生作用的自由硫脢基(親核的-SH)。"],"note":"","evidence_total":12,"summary_is_excerpt":true},"common-27":{"engine_version":28,"license":"衛部藥製字第061988號","leaflet_version":"2","source_sha256":"b9a86e436995934d023f750cb3d3b50e8d59ab59e0a024b9123e5c3e021b12ca","question_id":"common-27","question":"藥物動力學","answer_text":"仿單未明確記載。","status":"仿單未明確記載","evidence":[],"evidence_section_id":[],"evidence_quote":[],"note":"","checked_sections":["s37"]},"common-28":{"engine_version":28,"license":"衛部藥製字第061988號","leaflet_version":"2","source_sha256":"b9a86e436995934d023f750cb3d3b50e8d59ab59e0a024b9123e5c3e021b12ca","question_id":"common-28","question":"半衰期","answer_text":"仿單未明確記載。","status":"仿單未明確記載","evidence":[],"evidence_section_id":[],"evidence_quote":[],"note":"","checked_sections":["s34","s35","s37"]},"common-29":{"engine_version":28,"license":"衛部藥製字第061988號","leaflet_version":"2","source_sha256":"b9a86e436995934d023f750cb3d3b50e8d59ab59e0a024b9123e5c3e021b12ca","question_id":"common-29","question":"包裝儲存","answer_text":"請儲存於25℃以下。\n有效期限請見外盒。\n每包2.6公克，鋁箔袋盒裝。","status":"原文候選","evidence":[{"section_id":"s42","no":"13.3","title":"儲存條件","quote":"請儲存於25℃以下。","context":"包裝及儲存","text_source":"VALUE","start":0,"end":10,"score":70,"dedicated":false,"order":410000},{"section_id":"s41","no":"13.2","title":"效期","quote":"有效期限請見外盒。","context":"包裝及儲存","text_source":"VALUE","start":0,"end":9,"score":35,"dedicated":false,"order":400000},{"section_id":"s40","no":"13.1","title":"包裝","quote":"每包2.6公克，鋁箔袋盒裝。","context":"包裝及儲存","text_source":"VALUE","start":0,"end":14,"score":25,"dedicated":false,"order":390000}],"evidence_section_id":["s42","s41","s40"],"evidence_quote":["請儲存於25℃以下。","有效期限請見外盒。","每包2.6公克，鋁箔袋盒裝。"],"note":"","evidence_total":3,"summary_is_excerpt":true},"common-30":{"engine_version":28,"license":"衛部藥製字第061988號","leaflet_version":"2","source_sha256":"b9a86e436995934d023f750cb3d3b50e8d59ab59e0a024b9123e5c3e021b12ca","question_id":"common-30","question"