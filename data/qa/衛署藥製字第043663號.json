evidence_total":1,"summary_is_excerpt":true},"common-20":{"engine_version":27,"license":"衛署藥製字第043663號","leaflet_version":"2","source_sha256":"58a0512dbb67883e987dd81862e7db7a90ab6d76195496959efbe02da13ff9b4","question_id":"common-20","question":"懷孕注意事項","answer_text":"孕婦之投與：本品不建議孕婦使用。\n孕婦之投與：尤其是懷孕期後三個月之孕婦，可能對未出生胎兒會造成發展或併發症的問題。\n孕婦之投與：因本品抑制Prostaglandin合成，會造成致命性的胎兒動脈導管過早關閉、延長分娩時間或遲產，且使新生胎兒及母親的出血時間增加。","status":"待人工審核","evidence":[{"section_id":"s19","no":"6.1","title":"懷孕","quote":"本品不建議孕婦使用。","context":"特殊族群注意事項","text_source":"VALUE","start":7,"end":17,"score":105,"dedicated":true,"order":180000,"scope_label":"孕婦之投與","scope_quote":"孕婦之投與："},{"section_id":"s19","no":"6.1","title":"懷孕","quote":"尤其是懷孕期後三個月之孕婦，可能對未出生胎兒會造成發展或併發症的問題。","context":"特殊族群注意事項","text_source":"VALUE","start":17,"end":52,"score":91,"dedicated":true,"order":180001,"scope_label":"孕婦之投與","scope_quote":"孕婦之投與："},{"section_id":"s19","no":"6.1","title":"懷孕","quote":"因本品抑制Prostaglandin合成，會造成致命性的胎兒動脈導管過早關閉、延長分娩時間或遲產，且使新生胎兒及母親的出血時間增加。","context":"特殊族群注意事項","text_source":"VALUE","start":52,"end":118,"score":91,"dedicated":true,"order":180002,"scope_label":"孕婦之投與","scope_quote":"孕婦之投與："}],"evidence_section_id":["s19","s19","s19"],"evidence_quote":["本品不建議孕婦使用。","尤其是懷孕期後三個月之孕婦，可能對未出生胎兒會造成發展或併發症的問題。","因本品抑制Prostaglandin合成，會造成致命性的胎兒動脈導管過早關閉、延長分娩時間或遲產，且使新生胎兒及母親的出血時間增加。"],"note":"","evidence_total":3,"summary_is_excerpt":true},"common-21":{"engine_version":27,"license":"衛署藥製字第043663號","leaflet_version":"2","source_sha256":"58a0512dbb67883e987dd81862e7db7a90ab6d76195496959efbe02da13ff9b4","question_id":"common-21","question":"哺乳注意事項","answer_text":"授乳婦之投與：因藥物會分泌於乳汁中，且新生兒對水楊酸鹽的排泄慢，對於aspirin之抗血小板作用比較敏感，授乳婦女應避免使用。","status":"待人工審核","evidence":[{"section_id":"s20","no":"6.2","title":"哺乳","quote":"因藥物會分泌於乳汁中，且新生兒對水楊酸鹽的排泄慢，對於aspirin之抗血小板作用比較敏感，授乳婦女應避免使用。","context":"特殊族群注意事項","text_source":"VALUE","start":8,"end":64,"score":105,"dedicated":true,"order":190000,"scope_label":"授乳婦之投與","scope_quote":"授乳婦之投與："}],"evidence_section_id":["s20"],"evidence_quote":["因藥物會分泌於乳汁中，且新生兒對水楊酸鹽的排泄慢，對於aspirin之抗血小板作用比較敏感，授乳婦女應避免使用。"],"note":"","evidence_total":1,"summary_is_excerpt":true},"common-22":{"engine_version":27,"license":"衛署藥製字第043663號","leaflet_version":"2","source_sha256":"58a0512dbb67883e987dd81862e7db7a90ab6d76195496959efbe02da13ff9b4","question_id":"common-22","question":"禁忌症","answer_text":"本品禁用於對aspirin或salicylate成分過敏之病患。\n本品對於患有嚴重之肝、腎臟疾病、血液或出血方面之疾病、糜爛性胃炎、消化性潰瘍之患者，禁用本品。\n懷孕第3期。\n（重點節錄，請配合來源章節確認完整限制。）","status":"待人工審核","evidence":[{"section_id":"s11","no":"4","title":"禁忌","quote":"本品禁用於對aspirin或salicylate成分過敏之病患。","context":"","text_source":"VALUE","start":8,"end":40,"score":34,"dedicated":false,"order":100000},{"section_id":"s11","no":"4","title":"禁忌","quote":"本品對於患有嚴重之肝、腎臟疾病、血液或出血方面之疾病、糜爛性胃炎、消化性潰瘍之患者，禁用本品。","context":"","text_source":"VALUE","start":41,"end":88,"score":34,"dedicated":false,"order":100001},{"section_id":"s11","no":"4","title":"禁忌","quote":"懷孕第3期。","context":"","text_source":"VALUE","start":89,"end":95,"score":20,"dedicated":false,"order":100002}],"evidence_section_id":["s11","s11","s11"],"evidence_quote":["本品禁用於對aspirin或salicylate成分過敏之病患。","本品對於患有嚴重之肝、腎臟疾病、血液或出血方面之疾病、糜爛性胃炎、消化性潰瘍之患者，禁用本品。","懷孕第3期。"],"note":"","evidence_total":3,"summary_is_excerpt":true},"common-23":{"engine_version":27,"license":"衛署藥製字第043663號","leaflet_version":"2","source_sha256":"58a0512dbb67883e987dd81862e7db7a90ab6d76195496959efbe02da13ff9b4","question_id":"common-23","question":"常見副作用","answer_text":"仿單列有以下不良反應；未必代表常見：\n於本品治療期間所發生的主要副作用有：胃腸道不適、噁心、嘔吐、腹瀉、胃粘膜腐蝕、胃腸道潰瘍及隱發性血液流失。\n本品以建議劑量，每天服用一粒，則發生副作用的危險性會降至最小。\n而酒精可能會使出血時間增加。","status":"待人工審核","evidence":[{"section_id":"s28","no":"8","title":"副作用/不良反應","quote":"於本品治療期間所發生的主要副作用有：胃腸道不適、噁心、嘔吐、腹瀉、胃粘膜腐蝕、胃腸道潰瘍及隱發性血液流失。","context":"","text_source":"VALUE","start":54,"end":107,"score":40,"dedicated":false,"order":270002},{"section_id":"s28","no":"8","title":"副作用/不良反應","quote":"本品以建議劑量，每天服用一粒，則發生副作用的危險性會降至最小。","context":"","text_source":"VALUE","start":8,"end":39,"score":20,"dedicated":false,"order":270000},{"section_id":"s28","no":"8","title":"副作用/不良反應","quote":"而酒精可能會使出血時間增加。","context":"","text_source":"VALUE","start":39,"end":53,"score":20,"dedicated":false,"order":270001},{"section_id":"s28","no":"8","title":"副作用/不良反應","quote":"病人對aspirin過敏的各種反應，包括：蕁麻疹、其他皮疹、血管水腫(angioneurotic oedema)、鼻炎及嚴重的支氣管痙攣(bronchospam)。","context":"","text_source":"VALUE","start":108,"end":190,"score":20,"dedicated":false,"order":270003}],"evidence_section_id":["s28","s28","s28","s28"],"evidence_quote":["於本品治療期間所發生的主要副作用有：胃腸道不適、噁心、嘔吐、腹瀉、胃粘膜腐蝕、胃腸道潰瘍及隱發性血液流失。","本品以建議劑量，每天服用一粒，則發生副作用的危險性會降至最小。","而酒精可能會使出血時間增加。","病人對aspirin過敏的各種反應，包括：蕁麻疹、其他皮疹、血管水腫(angioneurotic oedema)、鼻炎及嚴重的支氣管痙攣(bronchospam)。"],"note":"","evidence_total":5,"summary_is_excerpt":true},"common-24":{"engine_version":27,"license":"衛署藥製字第043663號","leaflet_version":"2","source_sha256":"58a0512dbb67883e987dd81862e7db7a90ab6d76195496959efbe02da13ff9b4","question_id":"common-24","question":"嚴重警語","answer_text":"不得併服含酒精飲料，因可能造成胃出血。\n孕婦之投與：\n本品不建議孕婦使用。\n因藥物會分泌於乳汁中，且新生兒對水楊酸鹽的排泄慢，對於aspirin之抗血小板作用比較敏感，授乳婦女應避免使用。\n（重點節錄，請配合來源章節確認完整限制。）","status":"待人工審核","evidence":[{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"不得併服含酒精飲料，因可能造成胃出血。","context":"警語及注意事項","text_source":"VALUE","start":34,"end":53,"score":34,"dedicated":false,"order":120001},{"section_id":"s19","no":"6.1","title":"懷孕","quote":"孕婦之投與：\n本品不建議孕婦使用。","context":"特殊族群注意事項","text_source":"VALUE","start":0,"end":17,"score":34,"dedicated":false,"order":180001},{"section_id":"s20","no":"6.2","title":"哺乳","quote":"因藥物會分泌於乳汁中，且新生兒對水楊酸鹽的排泄慢，對於aspirin之抗血小板作用比較敏感，授乳婦女應避免使用。","context":"特殊族群注意事項","text_source":"VALUE","start":8,"end":64,"score":34,"dedicated":false,"order":190001},{"section_id":"s22","no":"6.4","title":"小兒","quote":"孩童之投與：\n本品不建議孩童及青少年使用。","context":"特殊族群注意事項","text_source":"VALUE","start":0,"end":21,"score":34,"dedicated":false,"order":210001}],"evidence_section_id":["s13","s19","s20","s22"],"evidence_quote":["不得併服含酒精飲料，因可能造成胃出血。","孕婦之投與：\n本品不建議孕婦使用。","因藥物會分泌於乳汁中，且新生兒對水楊酸鹽的排泄慢，對於aspirin之抗血小板作用比較敏感，授乳婦女應避免使用。","孩童之投與：\n本品不建議孩童及青少年使用。"],"note":"","evidence_total":12,"summary_is_excerpt":true},"common-25":{"engine_version":27,"license":"衛署藥製字第043663號","leaflet_version":"2","source_sha256":"58a0512dbb67883e987dd81862e7db7a90ab6d76195496959efbe02da13ff9b4","question_id":"common-25","question":"藥物交互作用","answer_text":"本品若與抗凝血劑併用時，則需監測病人的凝血情形。\n（重點節錄，請配合來源章節確認完整限制。）","status":"待人工審核","evidence":[{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"本品若與抗凝血劑併用時，則需監測病人的凝血情形。","context":"警語及注意事項","text_source":"VALUE","start":250,"end":274,"score":16,"dedicated":false,"order":120006}],"evidence_section_id":["s13"],"evidence_quote":["本品若與抗凝血劑併用時，則需監測病人的凝血情形。"],"note":"","evidence_total":1,"summary_is_excerpt":true},"common-26":{"engine_version":27,"license":"衛署藥製字第043663號","leaflet_version":"2","source_sha256":"58a0512dbb67883e987dd81862e7db7a90ab6d76195496959efbe02da13ff9b4","question_id":"common-26","question":"作用機轉","answer_text":"本品為腸溶設計，可避免胃部刺激性，胃腸副作用少。\n由文獻指出，低劑量之aspirin具選擇性且不可逆地阻斷血小板中thromboxane的形成，阻止血小板的凝集反應。\n本品為微粒劑型，具穩定釋放的效果，可獲得安全有效之治療。","status":"待人工審核","evidence":[{"section_id":"s34","no":"10.1","title":"作用機轉","quote":"本品為腸溶設計，可避免胃部刺激性，胃腸副作用少。","context":"藥理特性","text_source":"VALUE","start":0,"end":24,"score":34,"dedicated":false,"order":330000},{"section_id":"s34","no":"10.1","title":"作用機轉","quote":"由文獻指出，低劑量之aspirin具選擇性且不可逆地阻斷血小板中thromboxane的形成，阻止血小板的凝集反應。","context":"藥理特性","text_source":"VALUE","start":117,"end":175,"score":34,"dedicated":false,"order":330005},{"section_id":"s34","no":"10.1","title":"作用機轉","quote":"本品為微粒劑型，具穩定釋放的效果，可獲得安全有效之治療。","context":"藥理特性","text_source":"VALUE","start":25,"end":53,"score":20,"dedicated":false,"order":330001}],"evidence_section_id":["s34","s34","s34"],"evidence_quote":["本品為腸溶設計，可避免胃部刺激性，胃腸副作用少。","由文獻指出，低劑量之aspirin具選擇性且不可逆地阻斷血小板中thromboxane的形成，阻止血小板的凝集反應。","本品為微粒劑型，具穩定釋放的效果，可獲得安全有效之治療。"],"note":"","evidence_total":12,"summary_is_exce