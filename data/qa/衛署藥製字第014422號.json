11,"summary_is_excerpt":true},"common-09":{"engine_version":26,"license":"衛署藥製字第014422號","leaflet_version":"2","source_sha256":"673c80d15cfc99ba368255769b8366cec28379cbc27b1d508f2b9853bb34fb3d","question_id":"common-09","question":"最高劑量","answer_text":"小童劑量(2-6歲)：如需服用四次時,每日劑量以不超過12毫克為限。\n(6-14歲)：每日總劑量 以不超過16毫克為限。\n成人劑量：每日之總劑量以不超過32毫克為限。","status":"待人工審核","evidence":[{"section_id":"s8","no":"3.1","title":"用法用量","quote":"如需服用四次時，每日劑量以不超過12毫克為限。","start":137,"end":160,"context":"用法及用量","text_source":"VALUE","scope_label":"小童劑量(2-6歲)","scope_quote":"小童劑量(2-6歲)："},{"section_id":"s8","no":"3.1","title":"用法用量","quote":"每日總劑量\n以不超過16毫克為限。","start":229,"end":246,"context":"用法及用量","text_source":"VALUE","scope_label":"(6-14歲)","scope_quote":"(6-14歲)："},{"section_id":"s8","no":"3.1","title":"用法用量","quote":"每日之總劑量以不超過32毫克為限。","start":351,"end":368,"context":"用法及用量","text_source":"VALUE","scope_label":"成人劑量","scope_quote":"成人劑量："}],"evidence_section_id":["s8","s8","s8"],"evidence_quote":["如需服用四次時，每日劑量以不超過12毫克為限。","每日總劑量\n以不超過16毫克為限。","每日之總劑量以不超過32毫克為限。"],"review_reason":"有最高用量明文，仍須核對適應症與族群","note":"","decision":"maximum_statement"},"common-10":{"engine_version":26,"license":"衛署藥製字第014422號","leaflet_version":"2","source_sha256":"673c80d15cfc99ba368255769b8366cec28379cbc27b1d508f2b9853bb34fb3d","question_id":"common-10","question":"每日使用次數","answer_text":"劑量必須因人而異，因一次服量有效時間為4-6小時，故每日所需總\n量應分三次或較多次數服用，以供繼續療效。\n小童劑量(2-6歲)：開始用時，每日三次，每次2毫克(5c.c)視于病者之反應而增減用量\n，至適可為止。\n(6-14歲)：通常為每日三次，每次4毫克(10c.c)，根據病者之反應而增減劑量至\n適可為止，如每日須服四次，則可於臨睡前多服一次。","status":"待人工審核","evidence":[{"section_id":"s8","no":"3.1","title":"用法用量","quote":"劑量必須因人而異，因一次服量有效時間為4-6小時，故每日所需總\n量應分三次或較多次數服用，以供繼續療效。","context":"用法及用量","text_source":"VALUE","start":0,"end":52,"score":87,"dedicated":false,"order":70000},{"section_id":"s8","no":"3.1","title":"用法用量","quote":"開始用時，每日三次，每次2毫克(5c.c)視于病者之反應而增減用量\n，至適可為止。","context":"用法及用量","text_source":"VALUE","start":96,"end":137,"score":87,"dedicated":false,"order":70002,"scope_label":"小童劑量(2-6歲)","scope_quote":"小童劑量(2-6歲)："},{"section_id":"s8","no":"3.1","title":"用法用量","quote":"通常為每日三次，每次4毫克(10c.c)，根據病者之反應而增減劑量至\n適可為止，如每日須服四次，則可於臨睡前多服一次。","context":"用法及用量","text_source":"VALUE","start":170,"end":229,"score":87,"dedicated":false,"order":70004,"scope_label":"(6-14歲)","scope_quote":"(6-14歲)："}],"evidence_section_id":["s8","s8","s8"],"evidence_quote":["劑量必須因人而異，因一次服量有效時間為4-6小時，故每日所需總\n量應分三次或較多次數服用，以供繼續療效。","開始用時，每日三次，每次2毫克(5c.c)視于病者之反應而增減用量\n，至適可為止。","通常為每日三次，每次4毫克(10c.c)，根據病者之反應而增減劑量至\n適可為止，如每日須服四次，則可於臨睡前多服一次。"],"note":"","evidence_total":4,"summary_is_excerpt":true},"common-11":{"engine_version":26,"license":"衛署藥製字第014422號","leaflet_version":"2","source_sha256":"673c80d15cfc99ba368255769b8366cec28379cbc27b1d508f2b9853bb34fb3d","question_id":"common-11","question":"服藥時間與食物","answer_text":"仿單未明確記載。","status":"仿單未明確記載","evidence":[],"evidence_section_id":[],"evidence_quote":[],"note":"","checked_sections":["s7","s8","s9","s10","s27","s37","s44"]},"common-12":{"engine_version":26,"license":"衛署藥製字第014422號","leaflet_version":"2","source_sha256":"673c80d15cfc99ba368255769b8366cec28379cbc27b1d508f2b9853bb34fb3d","question_id":"common-12","question":"是否可以剝半","answer_text":"仿單未明確記載是否可以剝半。","status":"仿單未明確記載","evidence":[],"evidence_section_id":[],"evidence_quote":[],"review_reason":"未找到本規格的明確分錠記載","decision":"not_stated"},"common-13":{"engine_version":26,"license":"衛署藥製字第014422號","leaflet_version":"2","source_sha256":"673c80d15cfc99ba368255769b8366cec28379cbc27b1d508f2b9853bb34fb3d","question_id":"common-13","question":"是否可以磨粉或咀嚼","answer_text":"本糖漿除供小孩服用\n外，成人如對吞服藥丸感困難時，亦可使用之。","status":"待人工審核","evidence":[{"section_id":"s8","no":"3.1","title":"用法用量","quote":"本糖漿除供小孩服用\n外，成人如對吞服藥丸感困難時，亦可使用之。","context":"用法及用量","text_source":"VALUE","start":52,"end":83,"score":32,"dedicated":false,"order":70001}],"evidence_section_id":["s8"],"evidence_quote":["本糖漿除供小孩服用\n外，成人如對吞服藥丸感困難時，亦可使用之。"],"note":"磨粉：仿單未明確記載。不可僅由咀嚼或吞服敘述推定其他處理方式。","evidence_total":1,"summary_is_excerpt":t