","s23","s24","s25","s26","s27","s28","s29","s30","s31","s32","s43","s44"]},"common-22":{"engine_version":26,"license":"衛署藥製字第031896號","leaflet_version":"2","source_sha256":"23435c6df19c74afc5dcd095b06e98b6f8d55425b90afcc559185c190dc14a8e","question_id":"common-22","question":"禁忌症","answer_text":"仿單未明確記載。","status":"仿單未明確記載","evidence":[],"evidence_section_id":[],"evidence_quote":[],"note":"","checked_sections":["s11"]},"common-23":{"engine_version":26,"license":"衛署藥製字第031896號","leaflet_version":"2","source_sha256":"23435c6df19c74afc5dcd095b06e98b6f8d55425b90afcc559185c190dc14a8e","question_id":"common-23","question":"常見副作用","answer_text":"仿單列有以下不良反應；未必代表常見：\n有極少數的報告指出，發生如：多形性紅斑（erythema multiforme）、史帝文生氏-強生症候群/毒性表皮壞死溶解症（Stevens-Johnson syndrome<SJS>/toxic epidermal necrolysis<TEN>）、急性廣泛性發疹性膿疱症（acute generalised exanthematous pustulosis<AGEP>）等嚴重皮膚損害，與使用祛痰劑，如含ambroxol或bromhexine成分藥品有時間關聯性，但這些案例通常與患者的潛在疾病及/或併用藥物有關。","status":"待人工審核","evidence":[{"section_id":"s29","no":"8.1","title":"臨床重要副作用/不良反應","quote":"有極少數的報告指出，發生如：多形性紅斑（erythema multiforme）、史帝文生氏-強生症候群/毒性表皮壞死溶解症（Stevens-Johnson syndrome<SJS>/toxic epidermal necrolysis<TEN>）、急性廣泛性發疹性膿疱症（acute generalised exanthematous pustulosis<AGEP>）等嚴重皮膚損害，與使用祛痰劑，如含ambroxol或bromhexine成分藥品有時間關聯性，但這些案例通常與患者的潛在疾病及/或併用藥物有關。","context":"副作用/不良反應","text_source":"VALUE","start":0,"end":259,"score":20,"dedicated":false,"order":280000},{"section_id":"s29","no":"8.1","title":"臨床重要副作用/不良反應","quote":"此外，在該等嚴重皮膚不良反應的早期階段，患者可能先出現類似流感的非專一性前兆症狀（如：發燒、身體感覺痠痛、鼻炎、咳嗽及喉嚨痛）。","context":"副作用/不良反應","text_source":"VALUE","start":259,"end":323,"score":20,"dedicated":false,"order":280001},{"section_id":"s29","no":"8.1","title":"臨床重要副作用/不良反應","quote":"若受這些類似流感之非專一性前兆症狀的誤導，一開始可能會使用咳嗽及感冒藥來作症狀治療。","context":"副作用/不良反應","text_source":"VALUE","start":323,"end":365,"score":20,"dedicated":false,"order":280002},{"section_id":"s29","no":"8.1","title":"臨床重要副作用/不良反應","quote":"罕見：過敏反應 (hypersensitivity reactions)\n頻率未知：過敏性反應 (anaphylactic reactions) (包括：過敏性休克、血管性水腫、瘙癢症)","context":"副作用/不良反應","text_source":"VALUE","start":410,"end":503,"score":20,"dedicated":false,"order":280006}],"evidence_section_id":["s29","s29","s29","s29"],"evidence_quote":["有極少數的報告指出，發生如：多形性紅斑（erythema multiforme）、史帝文生氏-強生症候群/毒性表皮壞死溶解症（Stevens-Johnson syndrome<SJS>/toxic epidermal necrolysis<TEN>）、急性廣泛性發疹性膿疱症（acute generalised exanthematous pustulosis<AGEP>）等嚴重皮膚損害，與使用祛痰劑，如含ambroxol或bromhexine成分藥品有時間關聯性，但這些案例通常與患者的潛在疾病及/或併用藥物有關。","此外，在該等嚴重皮膚不良反應的早期階段，患者可能先出現類似流感的非專一性前兆症狀（如：發燒、身體感覺痠痛、鼻炎、咳嗽及喉嚨痛）。","若受這些類似流感之非專一性前兆症狀的誤導，一開始可能會使用咳嗽及感冒藥來作症狀治療。","罕見：過敏反應 (hypersensitivity reactions)\n頻率未知：過敏性反應 (anaphylactic reactions) (包括：過敏性休克、血管性水腫、瘙癢症)"],"note":"","evidence_total":7,"summary_is_excerpt":true},"common-24":{"engine_version":26,"license":"衛署藥製字第031896號","leaflet_version":"2","source_sha256":"23435c6df19c74afc5dcd095b06e98b6f8d55425b90afcc559185c190dc14a8e","question_id":"common-24","question":"嚴重警語","answer_text":"誠如任何製劑，於懷孕的前三個月並不推薦使用。\n（重點節錄，請配合來源章節確認完整限制。）","status":"待人工審核","evidence":[{"section_id":"s19","no":"6.1","title":"懷孕","quote":"誠如任何製劑，於懷孕的前三個月並不推薦使用。","context":"特殊族群注意事項","text_source":"VALUE","start":0,"end":22,"score":20,"dedicated":false,"order":180000}],"evidence_section_id":["s19"],"evidence_quote":["誠如任何製劑，於懷孕的前三個月並不推薦使用。"],"note":"","evidence_total":1,"summary_is_excerpt":true},"common-25":{"engine_version":26,"license":"衛署藥製字第031896號","leaflet_version":"2","source_sha256":"23435c6df19c74afc5dcd095b06e98b6f8d55425b90afcc559185c190dc14a8e","question_id":"common-25","question":"藥物交互作用","answer_text":"Musco可與其他藥物併用，尤其是可與抗生素、皮質類固醇及支氣管擴張劑等藥品併用。\n（重點節錄，請配合來源章節確認完整限制。）","status":"待人工審核","evidence":[{"section_id":"s27","no":"7","title":"交互作用","quote":"Musco可與其他藥物併用，尤其是可與抗生素、皮質類固醇及支氣管擴張劑等藥品併用。","context":"","text_source":"VALUE","start":9,"end":50,"score":46,"dedicated":false,"order":260000}],"evidence_section_id":["s27"],"evidence_quote":["Musco可與其他藥物併用，尤其是可與抗生素、皮質類固醇及支氣管擴張劑等藥品併用。"],"note":"","evidence_total":1,"summary_is_excerpt":true},"common-26"