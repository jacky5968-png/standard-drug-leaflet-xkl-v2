art":32,"end":51,"score":20,"dedicated":false,"order":270002}],"evidence_section_id":["s28","s28"],"evidence_quote":["1)消化系統\n很少有噁心及嘔吐之出現。","2)過敏症\n很少有發疹等過敏症狀之出現"],"note":"","evidence_total":2,"summary_is_excerpt":true},"common-24":{"engine_version":26,"license":"衛部藥製字第059282號","leaflet_version":"2","source_sha256":"0eafdbdf33d44656f78151d5f280f4b8a7fbf11c79981a4ad1870873fb657f8e","question_id":"common-24","question":"嚴重警語","answer_text":"使用上之注意事項(依文獻刊載)\n(1)下列患者須慎重投與\n1)曾患有消化性潰瘍之患者及活動性消化性潰瘍之患者。\n（重點節錄，請配合來源章節確認完整限制。）","status":"待人工審核","evidence":[{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"使用上之注意事項(依文獻刊載)","context":"警語及注意事項","text_source":"VALUE","start":0,"end":15,"score":20,"dedicated":false,"order":120000},{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"(1)下列患者須慎重投與","context":"警語及注意事項","text_source":"VALUE","start":16,"end":28,"score":20,"dedicated":false,"order":120001},{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"1)曾患有消化性潰瘍之患者及活動性消化性潰瘍之患者。","context":"警語及注意事項","text_source":"VALUE","start":29,"end":55,"score":20,"dedicated":false,"order":120002},{"section_id":"s13","no":"5.1","title":"警語/注意事項","quote":"2)支氣管氣喘之患者。","context":"警語及注意事項","text_source":"VALUE","start":56,"end":67,"score":20,"dedicated":false,"order":120003}],"evidence_section_id":["s13","s13","s13","s13"],"evidence_quote":["使用上之注意事項(依文獻刊載)","(1)下列患者須慎重投與","1)曾患有消化性潰瘍之患者及活動性消化性潰瘍之患者。","2)支氣管氣喘之患者。"],"note":"","evidence_total":7,"summary_is_excerpt":true},"common-25":{"engine_version":26,"license":"衛部藥製字第059282號","leaflet_version":"2","source_sha256":"0eafdbdf33d44656f78151d5f280f4b8a7fbf11c79981a4ad1870873fb657f8e","question_id":"common-25","question":"藥物交互作用","answer_text":"仿單未明確記載。","status":"仿單未明確記載","evidence":[],"evidence_section_id":[],"evidence_quote":[],"note":"","checked_sections":["s7","s8","s9","s10","s11","s12","s13","s14","s15","s16","s17","s18","s19","s20","s21","s22","s23","s24","s25","s26","s27","s43"]},"common-26":{"engine_version":26,"license":"衛部藥製字第059282號","leaflet_version":"2","source_sha256":"0eafdbdf33d44656f78151d5f280f4b8a7fbf11c79981a4ad1870873fb657f8e","question_id":"common-26","question":"作用機轉","answer_text":"Betahistine mesilate對微小循環系統，特別是內耳毛細血管前括約肌具有弛緩作用，除能增加內耳血管系之血流之外，因能調整內耳毛細血管之透過性，而除去內淋巴水腫。\n且因能增加內頸動脈之血流量，也改善腦循環，因此可消除眩暈、眩暈感。\n性質","status":"待人工審核","evidence":[{"section_id":"s34","no":"10.1","title":"作用機轉","quote":"Betahistine mesilate對微小循環系統，特別是內耳毛細血管前括約肌具有弛緩作用，除能增加內耳血管系之血流之外，因能調整內耳毛細血管之透過性，而除去內淋巴水腫。","context":"藥理特性","text_source":"VALUE","start":0,"end":87,"score":20,"dedicated":false,"order":330000},{"section_id":"s34","no":"10.1","title":"作用機轉","quote":"且因能增加內頸動脈之血流量，也改善腦循環，因此可消除眩暈、眩暈感。","context":"藥理特性","text_source":"VALUE","start":87,"end":120,"score":20,"dedicated":false,"order":330001},{"section_id":"s35","no":"10.2","title":"藥效藥理特性","quote":"性質","context":"藥理特性","text_source":"VALUE","start":0,"end":2,"score":20,"dedicated":false,"order":340000}],"evidence_section_id":["s34","s34","s35"],"evidence_quote":["Betahistine mesilate對微小循環系統，特別是內耳毛細血管前括約肌具有弛緩作用，除能增加內耳血管系之血流之外，因能調整內耳毛細血管之透過性，而除去內淋巴水腫。","且因能增加內頸動脈之血流量，也改善腦循環，因此可消除眩暈、眩暈感。","性質"],"note":"","evidence_total":13,"summary_is_excerpt":true},"common-27":{"engine_version":26,"license":"衛部藥製字第059282號","leaflet_version":"2","source_sha256":"0eafdbdf33d44656f78151d5f280f4b8a7fbf11c79981a4ad1870873fb657f8e","question_id":"common-27","question":"藥物動力學","answer_text":"吸收·分佈·排泄\n給予狗(體重約10kg左右)，經口投與240mg betahistine mesilate，測定血漿中之濃度，結果在投與60-90分後達到最高值，以後迅速消失。\n以3H標識之betahistine mesilate經口投與給大白鼠5-6mg/kg時，其器官內分佈，以肝臟最高，次為脂肪組織，脾、腎之順序，24小時以內在尿中之排泄為投與量之10-30%，糞中之排泄為50-70%。","status":"待人工審核","evidence":[{"section_id":"s37","no":"11","title":"藥物動力學特性","quote":"吸收·分佈·排泄\n給予狗(體重約10kg左右)，經口投與240mg betahistine mesilate，測定血漿中之濃度，結果在投與60-90分後達到最高值，以後迅速消失。","context":"","text_source":"VALUE","start":8,"end":97,"score":20,"dedicated":false,"order":360000},{"section_id":"s37","no":"11","title":"藥物動力學特性","quote":"以3H標識之betahistine mesilate經口投與給大白鼠5-6mg/kg時